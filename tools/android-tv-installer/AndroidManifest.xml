<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xingjue.tvskill.setup"
    android:versionCode="2"
    android:versionName="1.1.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <package android:name="com.leslie.tvhome" />
        <package android:name="com.xingjue.tvskill.marco" />
    </queries>
    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/tv_icon"
        android:label="@string/app_name"
        android:theme="@style/TvSetupTheme"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".InstallFileProvider"
            android:authorities="com.xingjue.tvskill.setup.install"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
